{
  "description": "overnight guard: .overnight/deadline 을 쓴 세션에 한해 마감 전 Stop 차단, 질문·stdin 대기 명령 거부, 커밋 찜 장부, 마무리 검사, watchdog 재시작",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ]
  }
}
