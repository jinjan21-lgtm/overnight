{
  "description": "overnight guard: .overnight/deadline 을 쓴 세션에 한해, 마감 전 Stop 차단, AskUserQuestion 거부, stdin 대기 명령 차단",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/overnight/hooks/guard.js\""
          }
        ]
      }
    ]
  }
}
